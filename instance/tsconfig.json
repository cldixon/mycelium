{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@types/bun"],
    "noEmit": true,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false
  },
  // .cloudflare/types is generated by `cf workers types` (and by cf build/dev)
  // from cloudflare.config.ts: the Env type plus the Workers runtime types.
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "cloudflare.config.ts",
    "config.ts",
    "wrangler.config.ts",
    ".cloudflare/types/index.d.ts"
  ]
}
